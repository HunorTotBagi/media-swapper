{
  "manifest_version": 3,
  "name": "Media Swapper",
  "version": "0.2.0",
  "description": "Swap playback between YouTube and Spotify automatically as you move between VS Code and YouTube.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["alarms", "scripting", "storage"],
  "host_permissions": ["https://open.spotify.com/*", "https://www.youtube.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Swap YouTube / Spotify",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://open.spotify.com/*"],
      "js": ["spotify-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-watcher.js"],
      "run_at": "document_start"
    }
  ]
}
